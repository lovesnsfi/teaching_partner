{
  "name": "lan-chat-broadcast",
  "version": "0.2.5",
  "private": true,
  "description": "局域网沟通与屏幕广播软件（Electron + Vue3，方案A WebRTC Mesh，无中心服务器）",
  "main": "out/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/lovesnsfi/teaching_partner.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder",
    "rebuild": "@electron/rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "electron-updater": "^6.3.4",
    "element-plus": "^2.14.7",
    "fluent-ffmpeg": "^2.1.3",
    "node-sqlite3-wasm": "^0.8.60",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.lan.chat.broadcast",
    "productName": "局域网沟通广播",
    "icon": "assets/ico/app.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-sqlite3-wasm/**",
      "**/node_modules/@ffmpeg-installer/**"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lovesnsfi",
        "repo": "teaching_partner",
        "releaseType": "release"
      }
    ]
  }
}
